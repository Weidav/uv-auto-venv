{
  "name": "uv-auto-venv",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainer-community/devcontainer-features/astral.sh-uv:1": {
      "shellautocompletion": true
    }
  },
  "postCreateCommand": "npm install",
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/node/.ssh,type=bind,readonly",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.gitconfig,target=/home/node/.gitconfig,type=bind,readonly"
  ],
  "customizations": {
    "idx": {
      "extensions": [
        "akamud.vscode-theme-onedark",
        "amodio.tsl-problem-matcher",
        "connor4312.esbuild-problem-matchers",
        "dbaeumer.vscode-eslint",
        "github.vscode-pull-request-github",
        "ms-vscode.extension-test-runner",
        "eamodio.gitlens"
      ]
    },
    "vscode": {
      "extensions": [
        "akamud.vscode-theme-onedark",
        "amodio.tsl-problem-matcher",
        "connor4312.esbuild-problem-matchers",
        "dbaeumer.vscode-eslint",
        "github.vscode-pull-request-github",
        "ms-vscode.extension-test-runner",
        "eamodio.gitlens"
      ]
    }
  }
}
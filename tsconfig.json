{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2024",
		"lib": [
			"ES2024"
		],
		"sourceMap": true,
		"rootDir": "src",
		"outDir": "out",
		"strict": true, /* enable all strict type-checking options */
		/* Additional Checks */
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedParameters": true,
		"types": [
			"node",
			"mocha"
		]
	}
}